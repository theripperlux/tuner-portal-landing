# dependencies
/node_modules

# next.js build output
/.next/
/out/
next-env.d.ts

# generated Prisma Client (regenerated by `prisma generate` / postinstall)
/src/generated/

# local databases (Prisma/SQLite) — never commit real or test data
dev.db
dev.db-journal
test.db
test.db-journal
*.db
!prisma/migrations/**/*.db

# env files — .env holds real secrets; only .env.example is tracked
.env
.env.local
.env.*.local

# build/test byproducts and command-output dumps
*.tsbuildinfo
*.log
/*.log
/*_output.txt
build.log

# ad hoc deploy/backup archives — regenerate, don't commit
/*.zip

# editor/OS
.DS_Store
Thumbs.db

.env

prisma/*.db

.claude
.agents
skills-lock.json