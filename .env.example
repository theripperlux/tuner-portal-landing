# Copy to .env and fill in real values. .env itself is gitignored — never commit it.

# Local Prisma/SQLite database
# Note: with the Prisma 7 driver-adapter model this path resolves relative to
# the process cwd (project root when running next dev/build/start or prisma
# CLI commands), NOT relative to prisma/schema.prisma like it did in Prisma 6.
DATABASE_URL="file:./prisma/dev.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=

# Base URL of the NestJS backend that exposes POST /public/tenant-registration
TENANT_API_URL="http://localhost:2600"

NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

NEXT_PUBLIC_GA_ID=
